NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ucs

# Redis
REDIS_URL=redis://localhost:6379

# JWT — must be at least 32 characters
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# CORS — comma-separated list of allowed origins (host sites + your admin UI)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
